# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Con dominio propio, agrega aquí su URL completa (ej. https://fichas.vicentecortez.cl).
CSRF_TRUSTED_ORIGINS=

# HTTPS (solo aplica con DEBUG=False). En producción déjalo en True.
# Para probar con DEBUG=False en tu PC sin certificado (http://localhost), ponlo en False.
SECURE_SSL_REDIRECT=True

# Docker: base de datos Postgres local que levanta docker-compose (servicio "db").
# Si DATABASE_URL está definido (Supabase), Docker usa esa base y no la local.
POSTGRES_DB=fdvc
POSTGRES_USER=fdvc
POSTGRES_PASSWORD=cambia-esta-clave
# Puerto del computador donde queda la plataforma (http://localhost:8000).
PUERTO_WEB=8000

# Supabase: Project Settings > Database > Connection string (URI). Usa el pooler (puerto 6543) o directo (5432).
# DATABASE_URL=postgresql://postgres.xxxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DB_SSL=True

# URL pública con la que se arman los enlaces de valoración que recibe el cliente.
SITIO_URL=http://127.0.0.1:8000

# Correo: la cuenta se configura desde la plataforma (Valoraciones > Canales y mensajes > Cuenta de correo).
# No hace falta poner nada aquí.

# Canales de envío: por ahora solo correo. Agrega whatsapp cuando esté contratado.
CANALES_ENVIO=email

# WhatsApp Cloud API de Meta (sin token, los envíos se simulan).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Reglas
VALORACION_PLAZO_DIAS=7
ENVIO_MAX_INTENTOS=3
AVISO_VENCIMIENTO_DIAS=15


